# Copié en `.env.production` sur le serveur, PAS committé (voir .gitignore).
# Utilisé uniquement par docker-compose (--env-file .env.production), pas par `npm run dev`.

# Mot de passe PostgreSQL pour le conteneur "db". Choisis une valeur forte.
POSTGRES_PASSWORD=change-me-strong-password

# Secret de signature des sessions (JWT). Génère une valeur aléatoire longue, par ex. :
#   openssl rand -base64 48
AUTH_SECRET=change-me-long-random-secret
