// Schema du portail COACH-NAT

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
}

enum Pole {
  FORMATION
  COMPETITION
  SAUVETAGE
  LOISIR
}

enum Nage {
  PAPILLON
  DOS
  BRASSE
  CRAWL
}

enum EtatEncadrement {
  ASSURE
  REMPLACE
  A_COUVRIR
}

enum TypeCreneau {
  EAU
  PHYSIQUE
  VIDEO
  RECUP
}

// Catégorie d'un rendez-vous récurrent de la semaine type qui n'est pas un
// entraînement (celui-ci reste porté par Creneau, avec groupe/coach/bassin).
enum CategorieEvenement {
  REUNION
  FORUM
  AUTRE
}

enum StatutStage {
  CONFIRME
  OUVERT
  EN_PREPARATION
}

enum EtatPresence {
  PRESENT
  RETARD
  ABSENT
  EXCUSE
}

enum StatutAbsence {
  VALIDEE
  A_TRAITER
  BLESSURE
}

enum StatutConge {
  VALIDE
  EN_ATTENTE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(COACH)
  coach               Coach?
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

// Jeton de réinitialisation de mot de passe envoyé par mail. Seul son hash
// (sha256) est stocké — jamais le jeton en clair — et il est à usage unique
// (usedAt) avec une durée de vie courte (voir lib/password-reset.ts).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Coach {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initials     String
  accessLevel  String   @default("Accès total")
  groupes      Groupe[]
  creneaux     Creneau[]
  evenementsSemaine EvenementSemaine[]
  stageCreneaux CreneauStage[]
  conges       Conge[]
  techniqueRatings NotationTechnique[]
  seanceInstances SeanceInstance[]
  inscriptions Inscription[]
  createdAt    DateTime @default(now())
}

model CategorieEffectif {
  id    String @id @default(cuid())
  nom   String
  pole  Pole
  count Int
}

model Groupe {
  id         String   @id @default(cuid())
  nom        String
  pole       Pole
  categorie  String
  color      String
  // Objectif manuel de repli, utilisé tant qu'aucun plan d'entraînement
  // (plansEntrainement) ne couvre la date du jour pour ce groupe.
  objectif   String?
  coachId    String?
  coach      Coach?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  nageurs    Nageur[]
  creneaux   Creneau[]
  inscriptions Inscription[]
  plansEntrainement PlanEntrainement[] @relation("PlanEntrainementGroupes")
  ajustementsPlan   AjustementPlan[]
  createdAt  DateTime @default(now())
}

model Nageur {
  id              String   @id @default(cuid())
  nom             String
  initiales       String
  age             Int
  // Année de naissance (saisie à la création/édition à la place d'un âge en
  // dur, qui se périme chaque année) — l'âge stocké ci-dessus est recalculé
  // à partir de celle-ci à chaque enregistrement.
  anneeNaissance  Int?
  categorie       String
  // Optionnelle : évolue avec le temps, sous l'appréciation du coach — pas
  // forcément connue dès l'inscription du nageur.
  specialite      String?
  // Identifiant unique fédéral (IUF) sur ffn.extranat.fr, une fois relié via
  // la recherche FFN sur la fiche nageur. Permet de resynchroniser les
  // performances sans redemander une recherche par nom.
  ffnIuf          String?
  ffnSyncedAt     DateTime?
  // Date d'arrivée au club (saisie manuelle, affichée sur la fiche nageur
  // en "membre depuis"). Distincte de l'historique par saison ci-dessous :
  // un nageur peut être arrivé il y a 3 saisons mais n'avoir d'Inscription
  // qu'à partir de la saison où ce suivi a été mis en place.
  membreDepuis    DateTime?
  groupeId        String?
  groupe          Groupe?  @relation(fields: [groupeId], references: [id], onDelete: SetNull)
  pointsFFN       Int      @default(0)
  rangDept        Int?
  rangReg         Int?
  rangNat         Int?
  presenceRate    Int      @default(0)
  performances    Performance[]
  notations       NotationTechnique[]
  absences        Absence[]
  inscriptions    Inscription[]
  creneauxEffectif CreneauNageur[]
  presences       Presence[]
  createdAt       DateTime @default(now())
}

// Une saison sportive du club (ex. "2026-2027"). Une seule est "active" à la
// fois (appliqué côté application, pas en contrainte SQL) : c'est elle qui
// détermine le badge affiché dans l'en-tête et la saison sur laquelle
// portent les nouvelles inscriptions et synchronisations FFN.
model Saison {
  id           String        @id @default(cuid())
  label        String        @unique
  dateDebut    DateTime
  dateFin      DateTime
  active       Boolean       @default(false)
  inscriptions Inscription[]
  createdAt    DateTime      @default(now())
}

// Photo, pour un nageur et une saison donnés, du groupe et du coach au
// moment où cette ligne a été créée/mise à jour — contrairement à
// Nageur.groupeId (toujours "en direct"), ceci ne bouge plus une fois la
// saison passée. Permet de répondre à "dans quel groupe/avec quel coach
// était ce nageur en 2025-2026 ?" même après un changement de groupe.
model Inscription {
  id        String   @id @default(cuid())
  nageurId  String
  nageur    Nageur   @relation(fields: [nageurId], references: [id], onDelete: Cascade)
  saisonId  String
  saison    Saison   @relation(fields: [saisonId], references: [id], onDelete: Cascade)
  groupeId  String?
  groupe    Groupe?  @relation(fields: [groupeId], references: [id], onDelete: SetNull)
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nageurId, saisonId])
}

model Performance {
  id         String   @id @default(cuid())
  nageurId   String
  nageur     Nageur   @relation(fields: [nageurId], references: [id], onDelete: Cascade)
  epreuve    String
  temps      String
  points     Int
  niveau     String
  deltaSaison String
  rangNat    String
  saison     String   @default("2025-2026")
  createdAt  DateTime @default(now())
}

model NotationTechnique {
  id          String   @id @default(cuid())
  nageurId    String
  nageur      Nageur   @relation(fields: [nageurId], references: [id], onDelete: Cascade)
  nage        Nage
  critere     String
  note        Int
  observation String?
  coachId     String?
  coach       Coach?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  date        DateTime @default(now())
}

model Creneau {
  id                String          @id @default(cuid())
  jour              Int
  debut             String
  fin               String
  groupeId          String
  groupe            Groupe          @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  coachId           String?
  coach             Coach?          @relation(fields: [coachId], references: [id], onDelete: SetNull)
  libelleCoach      String?
  bassin            String
  effectifLabel     String?
  etat              EtatEncadrement @default(ASSURE)
  // Si vrai (par défaut), ce créneau récurrent est automatiquement mis en
  // pause sur les semaines de vacances scolaires (zone définie dans
  // AppSettings) — le planning affiche alors les stages de la période à la
  // place. Mettre à faux pour un créneau qui continue toute l'année.
  actifHorsVacances Boolean         @default(true)
  instances         SeanceInstance[]
  // Sous-ensemble explicite du groupe qui assiste à ce créneau (ex. seuls
  // les 4 nages font le créneau technique du mardi). Aucune ligne pour ce
  // créneau = comportement par défaut, tout le groupe est attendu.
  effectifNageurs   CreneauNageur[]
  createdAt         DateTime        @default(now())
}

// Voir le commentaire sur Creneau.effectifNageurs : présence d'une ligne ici
// pour (creneauId, nageurId) = ce nageur fait partie de l'effectif attendu
// explicite du créneau, qui remplace alors "tout le groupe" par défaut.
model CreneauNageur {
  id        String  @id @default(cuid())
  creneauId String
  creneau   Creneau @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  nageurId  String
  nageur    Nageur  @relation(fields: [nageurId], references: [id], onDelete: Cascade)

  @@unique([creneauId, nageurId])
}

// Rendez-vous hebdomadaire récurrent hors entraînement (réunion, forum...),
// affiché dans la semaine type à côté des créneaux. Volontairement séparé de
// Creneau : ni groupe de nageurs, ni présence, ni effectif à gérer ici.
model EvenementSemaine {
  id        String             @id @default(cuid())
  jour      Int
  debut     String
  fin       String
  categorie CategorieEvenement @default(AUTRE)
  titre     String
  lieu      String?
  coachId   String?
  coach     Coach?             @relation(fields: [coachId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
}

model Stage {
  id            String        @id @default(cuid())
  nom           String
  periodeLabel  String
  dateDebut     DateTime?
  dateFin       DateTime?
  lieu          String
  groupesLabel  String
  coachsLabel   String
  statut        StatutStage   @default(EN_PREPARATION)
  color         String        @default("#8C6BFF")
  inscrits      Int           @default(0)
  places        Int           @default(20)
  budgetLabel   String?
  regleLabel    String        @default("0%")
  jours         StageJour[]
  creneaux      CreneauStage[]
  createdAt     DateTime      @default(now())
}

model StageJour {
  id        String   @id @default(cuid())
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  jour      Int
  dateLabel String
  date      DateTime?
}

// Réglages globaux du club, une seule ligne (id fixe "singleton"). Pour
// l'instant : la zone de vacances scolaires (A/B/C) utilisée pour mettre en
// pause les créneaux récurrents et faire apparaître les stages au planning.
model AppSettings {
  id           String @id @default("singleton")
  zoneScolaire String @default("B")
}

model CreneauStage {
  id        String      @id @default(cuid())
  stageId   String
  stage     Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  jour      Int
  debut     String
  fin       String
  type      TypeCreneau @default(EAU)
  groupe    String
  coachId   String?
  coach     Coach?      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  bassin    String
  theme     String
  volume    Int         @default(0)
  instances SeanceInstance[]
  createdAt DateTime    @default(now())
}

// Occurrence datée et concrète d'une séance : un Creneau (récurrent) ou un
// CreneauStage donne lieu, à une date précise, à une SeanceInstance. C'est sur
// cette instance que se rattachent la présence réelle (par date) et le volume
// effectivement nagé (journal d'entraînement), plutôt que sur le créneau
// générique qui ne représente qu'un horaire récurrent.
model SeanceInstance {
  id             String        @id @default(cuid())
  date           DateTime
  creneauId      String?
  creneau        Creneau?      @relation(fields: [creneauId], references: [id], onDelete: SetNull)
  creneauStageId String?
  creneauStage   CreneauStage? @relation(fields: [creneauStageId], references: [id], onDelete: SetNull)
  groupeNom      String
  coachId        String?
  coach          Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  variant        String?
  intensite      String?
  nage           String?
  volumeNage     Int?
  // Contenu détaillé (échauffement/technique/principal/retour), éventuellement
  // retouché à la main par le coach dans le créateur de séance avant de
  // planifier. Absent (séances plus anciennes) = recalculé à l'affichage à
  // partir de variant/intensite/nage/volumeNage.
  blocs          Json?
  // Override structuré (SectionManuelle[], cf. lib/seance-manual.ts) pour
  // cette occurrence précise uniquement — prioritaire sur le plan
  // d'entraînement du groupe le temps qu'il couvre cette date ; `blocs` est
  // alors recompilé à partir de ces sections plutôt que saisi séparément.
  sections       Json?
  heureDebut     String?
  presences      Presence[]
  createdAt      DateTime      @default(now())

  @@unique([creneauId, date])
  @@unique([creneauStageId, date])
}

model Presence {
  id               String         @id @default(cuid())
  seanceInstanceId String
  seanceInstance   SeanceInstance @relation(fields: [seanceInstanceId], references: [id], onDelete: Cascade)
  nomPersonne      String
  // Lien stable vers le nageur (rôle SWIMMER uniquement — un coach n'a pas
  // de fiche Nageur). nomPersonne reste la source d'affichage/unicité, mais
  // presenceRate se recalcule via cet id : sans lui, renommer un nageur
  // (typo corrigée, nom complété...) coupait silencieusement son historique
  // de présence antérieur du calcul (les lignes gardaient l'ancien nom).
  nageurId         String?
  nageur           Nageur?        @relation(fields: [nageurId], references: [id], onDelete: SetNull)
  role             String
  etat             EtatPresence   @default(PRESENT)
  updatedAt        DateTime       @updatedAt

  @@unique([seanceInstanceId, nomPersonne])
}

model Absence {
  id       String        @id @default(cuid())
  nageurId String
  nageur   Nageur        @relation(fields: [nageurId], references: [id], onDelete: Cascade)
  date     String
  motif    String
  statut   StatutAbsence @default(A_TRAITER)
}

model Conge {
  id           String      @id @default(cuid())
  coachId      String
  coach        Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  periodeLabel String
  motif        String
  impact       String
  statut       StatutConge @default(EN_ATTENTE)
}

model SeancePlan {
  id           String   @id @default(cuid())
  nom          String   @default("Modèle sans nom")
  groupeNom    String
  variant      String
  intensite    String
  nage         String
  volumeCible  Int
  blocs        Json
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// Plan d'entraînement d'un ou plusieurs groupes sur une période — point
// d'entrée unique qui remplace l'ancien PhaseObjectif (badge seul) et
// l'ancien contenu chiffré séparé : `theme` est le niveau macro, toujours
// renseigné et affiché comme badge sur les créneaux (Planning, Semaine
// type) tant que la période couvre la date du jour ; `sections` est le
// détail chiffré (cf. lib/seance-manual.ts), optionnel — un plan peut
// rester macro (thème seul) puis être détaillé plus tard sans rien
// recréer. Calculé à la lecture (cf. lib/objectifs.ts, lib/plan-entrainement.ts),
// sans tâche de fond.
model PlanEntrainement {
  id          String   @id @default(cuid())
  nom         String
  theme       String
  heureDebut  String?
  // Génération auto (cf. lib/seance-generator.ts) : alternative à `sections`
  // pour détailler le plan autour des 3 familles variant/intensité/nage —
  // recompilée à la lecture, sans ajustement en % possible (contenu texte,
  // pas de distances discrètes à l'inverse de `sections`).
  variant     String?
  intensite   String?
  nage        String?
  volumeNage  Int?
  sections    Json?
  dateDebut   DateTime
  dateFin     DateTime
  groupes     Groupe[] @relation("PlanEntrainementGroupes")
  ajustements AjustementPlan[]
  createdAt   DateTime @default(now())

  @@index([dateDebut])
}

// Ajustement ponctuel d'une section du plan pour un groupe et une date
// précise (ex. +30% sur la section "Jambes" pour le créneau du 12/10) —
// recalcule les distances de cette section à l'affichage sans toucher au
// plan ni aux autres occurrences.
model AjustementPlan {
  id          String           @id @default(cuid())
  planId      String
  plan        PlanEntrainement @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupeId    String
  groupe      Groupe           @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  date        DateTime
  sectionId   String
  pourcentage Int
  createdAt   DateTime         @default(now())

  @@unique([planId, groupeId, date, sectionId])
}

model Echeance {
  id            String   @id @default(cuid())
  date          DateTime
  titre         String
  detail        String
  color         String   @default("#1E7BFF")
  // Évite de renvoyer plusieurs fois le mail de rappel si la tâche cron
  // passe plusieurs fois dans la fenêtre de rappel avant l'échéance.
  rappelEnvoye  Boolean  @default(false)
}

model CycleThematique {
  id          String   @id @default(cuid())
  theme       String
  variant     String
  nage        String
  objectif    String
  groupeNom   String
  dureeSemaines Int
  seances     Json
  createdAt   DateTime @default(now())
}
